# ─── Frontend (Vercel) ─────────────────────────────────────────────────────────
# Base URL of the deployed Express backend (Render). Server components proxy
# /api and /uploads to this origin via next.config rewrites.
BACKEND_URL="http://localhost:3001"

# Shared with the backend — MUST be identical so server components (getSession)
# can verify the session cookie set by the API.
JWT_SECRET="change-this-to-a-secure-random-string-in-production"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
