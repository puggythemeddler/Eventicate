# ─── Database (Neon Postgres) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/eventicate?sslmode=require"

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"

# ─── App ───────────────────────────────────────────────────────────────────────
# Frontend origin (used for OAuth redirects and email links)
APP_URL="https://your-domain.com"
PORT=3001

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@your-domain.com"

# ─── Google OAuth (optional) ───────────────────────────────────────────────────
# Must point at the FRONTEND URL so the session cookie is set on the app origin.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/auth/google/callback"

# ─── M-Pesa (Daraja STK Push) ─────────────────────────────────────────────────
# Obtain from the Safaricom Daraja portal (developer.safaricom.co.ke).
# MPESA_ENV: "sandbox" (default) or "production"
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your-daraja-consumer-key"
MPESA_CONSUMER_SECRET="your-daraja-consumer-secret"
MPESA_PASSKEY="your-daraja-lipa-na-mpesa-passkey"
# Paybill/Till shortcode used for CustomerPayBillOnline (default 174379 in sandbox)
MPESA_SHORTCODE="174379"
# Publicly reachable HTTPS callback that Safaricom will POST the STK result to.
# Defaults to `${APP_URL}/api/payments/mpesa-callback`. Only override if the
# backend is hosted separately from the frontend (e.g. point at the Render URL).
# MPESA_CALLBACK_URL="https://your-backend-domain.com/api/payments/mpesa-callback"

# ─── Local Sync (optional) ─────────────────────────────────────────────────────
LOCAL_SYNC_ENABLED=false
LOCAL_SYNC_API_KEY=""
