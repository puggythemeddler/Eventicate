# Render environment file (read by render.yaml via envFromFile)
# Values here are injected into the eventicate-api service on Render.

NODE_ENV=production

# ─── Database (Neon) ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:npg_B0q2CnJOFjSd@ep-divine-salad-axlsvn0s-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Auth (MUST match the frontend's JWT_SECRET) ──────────────────────────────
JWT_SECRET="dev-secret-change-in-production"

# ─── App URLs ──────────────────────────────────────────────────────────────────
APP_URL="https://eventicate.vercel.app"
NEXT_PUBLIC_APP_URL="https://eventicate.vercel.app"
PORT=3001

# ─── M-Pesa (Daraja) ──────────────────────────────────────────────────────────
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL=""

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://eventicate.vercel.app/api/auth/google/callback"

# ─── Email / SMTP (optional) ──────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── Local Sync (optional) ────────────────────────────────────────────────────
LOCAL_SYNC_ENABLED="false"
LOCAL_SYNC_API_KEY=""
